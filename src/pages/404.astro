---
import Layout from "../layouts/Layout.astro";
---
<Layout>
    <main>
        <article class="nb-card p-10 flex items-center justify-center flex-col text-center space-y-4">
            <span class="nb-badge text-xs px-3 py-1">Error 404</span>
            <h1 class="text-6xl font-bold tracking-tight">404</h1>
            <p class="text-sm" style="color: var(--nb-muted);">
                This page could not be found. Please check the URL and try again.
            </p>
            <a href="/" class="nb-btn nb-btn-primary px-4 py-2 text-xs">
                ← Return Home
            </a>
        </article>
    </main>
</Layout>
