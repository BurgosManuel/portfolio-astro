---
import socialsData from '../data/socials.json';
import { Icon } from 'astro-icon/components';
---

<main class="mx-auto max-w-screen-sm p-5 space-y-6">
  <section class="flex items-center justify-center gap-5 p-5 flex-wrap sm:flex-nowrap sm:justify-between">
    <div class="avatar">
      <div class="ring-neutral ring-offset-base-100 rounded-full ring-2 ring-offset-2 w-40">
        <img
          src="/assets/images/me-crop.webp"
          alt="Manuel Burgos"
        />
      </div>
    </div>
    <div class="text-justify">
      <h2 class="text-xl font-semibold">Hi! 👋</h2>
      <p>
        I'm Manuel, Senior Software Engineer specializing in scalable backend systems and robust cloud infrastructure. I deliver end-to-end enterprise solutions while integrating AI tooling to optimize development efficiency.
      </p>
      <p class="mt-2">
        I have solid experience working in collaborative, agile environments, bringing strong adaptability to new projects and teams through fast learning and effective communication.
      </p>
      <div class="flex items-center gap-4 mt-4">
        <span class="font-semibold">Contact me on:</span>
        {socialsData.map((social) => (
          <a href={social.url} target="_blank" class="flex items-center gap-2">
            <Icon name={`social/${social.icon}`} class="badge badge-outline badge-xl rounded-full border-2 hover:bg-info-content" />
          </a>
        ))}
      </div>
    </div>
  </section>
</main>
