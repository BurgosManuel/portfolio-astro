---
import { Icon } from 'astro-icon/components';

interface Props extends Work {}

const { company, companySite, period, roles }: Props = Astro.props;
const multiple = roles.length > 1;
---
<article>
        <header class="flex flex-col items-left gap-3 justify-between flex-wrap sm:flex-row sm:items-center">
            <aside>
                <a href={companySite} target="_blank">
                    <h3 class="font-semibold inline">{company}</h3>
                    <Icon name="external-link" class="inline"/>
                </a>
                {!multiple && <p class="text-sm font-light">{roles[0].position}</p>}
            </aside>
            <p class="text-sm">{period}</p>
        </header>
        {roles.map((role) => (
            <section class="mt-3">
                {multiple && (
                    <div class="flex flex-col gap-1 justify-between sm:flex-row sm:items-center">
                        <p class="text-sm font-light">{role.position}</p>
                        <p class="text-sm">{role.period}</p>
                    </div>
                )}
                <ul class="mt-3 list-disc pl-5">
                    {role.tasks.map((task) => (
                        <li class="py-2">{task}</li>
                    ))}
                </ul>
            </section>
        ))}
</article>