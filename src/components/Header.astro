---
import { Icon } from "astro-icon/components";
---

<header class="nb-card px-5 py-3 flex items-center justify-between flex-wrap gap-3">
    <h1>
        <a href="/" class="font-bold text-base tracking-tight hover:underline underline-offset-4">
            Sergio Manuel Burgos
        </a>
    </h1>
    <nav class="flex items-center gap-3 text-sm font-semibold">
        <a
            class="nb-btn nb-btn-primary px-3.5 py-1.5 text-xs inline-flex items-center gap-1.5"
            href="https://drive.usercontent.google.com/download?id=1CRXS4RFtn-IoUNdVlFsQoHLMbRPuCWp-&export=download"
            target="_blank"
            rel="noopener noreferrer"
        >
            <span>Resume</span>
            <Icon name="download" class="w-4 h-4" />
        </a>
    </nav>
</header>
