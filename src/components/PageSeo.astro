---
interface Props {
  title?: string;
}

const { title } = Astro.props;
const description = "🙋 Hi! I'm Manuel, a software engineer focused on building enterprise software. With experience across the insurance and payments sectors, I prioritize understanding business constraints to deliver reliable, high-quality systems. I'm primarily backend-focused (Java, Spring), but I regularly ship end-to-end solutions using Angular. I'm also currently pursuing my degree in Systems Engineering.";
const structuredData = `
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Sergio Manuel Burgos",
  "url": "https://burgosmanuel.ar/"
}`
---
<title>{title || "Sergio Manuel Burgos | Senior Software Engineer"}</title>
<meta name="description" content={description}>
<meta name="author" content="Sergio Manuel Burgos">
<meta name="keywords" content="portfolio, senior software engineer, Java, Spring Boot, SQL, Microservices, Apache Kafka, Redis, Angular, TypeScript, JavaScript, AWS, Docker, GitHub Actions, Jenkins, Python, AI, Sergio Manuel Burgos, Manuel Burgos, burgosmanuel, burgosmanuel.ar">
<meta property="og:title" content={title || "Sergio Manuel Burgos | Senior Software Engineer"}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:locale" content="en_US">
<meta property="og:url" content="https://burgosmanuel.ar">
<meta property="og:image" content="/assets/images/me-crop.webp">
<meta property="og:site_name" content="Sergio Manuel Burgos" />
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title || "Sergio Manuel Burgos | Senior Software Engineer"}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content="/assets/images/me-crop.webp">
<script type="application/ld+json" set:html={structuredData} is:inline></script>
