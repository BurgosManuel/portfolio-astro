---
import { Icon } from 'astro-icon/components';
import workData from '../data/work.json';
import WorkEntry from './WorkEntry.astro';
---

<section class="space-y-4">
    <div class="flex items-center gap-2.5">
        <span class="nb-badge p-1.5 inline-flex items-center justify-center">
            <Icon name="ui/briefcase" class="w-4 h-4 text-[#1D4ED8]" />
        </span>
        <h2 class="text-xl font-bold tracking-tight">Work Experience</h2>
    </div>
    { workData.map((job) => (
        <WorkEntry
            company={job.company}
            companySite={job.companySite}
            period={job.period}
            roles={job.roles}
        />
    ))}
</section>
